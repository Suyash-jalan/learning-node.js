<%- include('../partials/head') %>
</head>

<body class="bg-gray-50/50 min-h-screen flex flex-col">
  <%- include('../partials/nav') %>

  <main class="flex-1 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-lg bg-white border border-gray-150 rounded-2xl shadow-xl p-8 sm:p-10">
      
      <!-- Back Link -->
      <a href="/host/host-home-list" class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-400 hover:text-rose-500 transition-colors mb-6 group">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-0.5 transition-transform">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        Back to listings
      </a>

      <!-- Header -->
      <h1 class="text-2xl font-bold text-gray-900 text-center mb-1"><%= editing ? "Edit Listing" : "Register Home" %></h1>
      <p class="text-sm text-gray-400 text-center mb-8"><%= editing ? "Update your property details below." : "Share your space and start hosting on AirBnB." %></p>

      <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST"  enctype="multipart/form-data" class="space-y-5">
        <input type="hidden" name="id" value="<%= editing ? home.id : ''%>" />
        
        <!-- House Name -->
        <div>
          <label for="houseName" class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1.5">House Name</label>
          <div class="relative">
            <input
              type="text"
              name="houseName"
              id="houseName"
              placeholder="e.g. Modern Cozy Beach Apartment"
              value="<%= editing ? home.houseName : '' %>"
              class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-800 placeholder-gray-400 outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all duration-200"
              required />
          </div>
        </div>

        <!-- Row for Price & Rating -->
        <div class="grid grid-cols-2 gap-4">
          <!-- Price per Night -->
          <div>
            <label for="price" class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1.5">Price Per Night (Rs)</label>
            <input
              type="number"
              name="price"
              id="price"
              placeholder="e.g. 3500"
              value="<%= editing ? home.price : '' %>"
              class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-800 placeholder-gray-400 outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all duration-200"
              required />
          </div>

          <!-- Rating -->
          <div>
            <label for="rating" class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1.5">Rating (0 - 5)</label>
            <input
              type="number"
              step="0.1"
              min="0"
              max="5"
              name="rating"
              id="rating"
              placeholder="e.g. 4.8"
              value="<%= editing ? home.rating : '' %>"
              class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-800 placeholder-gray-400 outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all duration-200"
              required />
          </div>
        </div>

        <!-- Location -->
        <div>
          <label for="location" class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1.5">Location</label>
          <input
            type="text"
            name="location"
            id="location"
            placeholder="e.g. Manhattan, New York"
            value="<%= editing ? home.location : '' %>"
            class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-800 placeholder-gray-400 outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all duration-200"
            required />
        </div>

        <!-- Photo URL -->
        <div>
          <label for="photo" class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1.5">Photo URL</label>
          <input
            type="file"
            name="photo"
            accept="image/jpg, image/jpeg, image/png"
            class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-800 placeholder-gray-400 outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all duration-200"
            required />
        </div>

        <!-- Description -->
        <div>
          <label for="description" class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1.5">Description</label>
          <textarea
            name="description"
            id="description"
            placeholder="Describe your cozy home stay..."
            class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-800 placeholder-gray-400 outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100 transition-all duration-200 resize-none"
            rows="4"><%= editing ? home.description : '' %></textarea>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="w-full py-3 mt-2 bg-gradient-to-r from-rose-500 to-rose-600 text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg hover:from-rose-600 hover:to-rose-700 active:scale-[0.98] transition-all duration-200 cursor-pointer">
          <%= editing ? "Update Home Details" : "Register Property" %>
        </button>

      </form>
    </div>
  </main>
</body>
</html>
