<%- include('../partials/head.ejs', { pageTitle: home.houseName }) %>
</head>

<body class="bg-gray-50/50 min-h-screen flex flex-col">
    <%- include('../partials/nav.ejs') %>

    <!-- Main Content Section -->
    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1 w-full">
        
        <!-- Back Button -->
        <a href="/homes" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-rose-500 transition-colors mb-6 group">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            Back to stays
        </a>

        <!-- Detail Container -->
        <div class="bg-white border border-gray-150 rounded-2xl p-6 sm:p-8 shadow-sm">
            <h2 class="text-xs uppercase font-bold text-rose-500 tracking-wider mb-2">you are in home detail page.</h2>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight mb-4"><%= home.houseName %></h1>

            <% if (home.photo) { %>
                <div class="relative aspect-[16/9] w-full rounded-xl overflow-hidden bg-gray-100 shadow-sm mb-6">
                    <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-full object-cover">
                </div>
            <% } %>

            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-100 pb-6 mb-6">
                <div class="space-y-1">
                    <p class="text-sm text-gray-500 flex items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        <%= home.location %>
                    </p>
                    <div class="flex items-center gap-1.5 text-sm font-semibold text-gray-800">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-amber-500">
                            <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                        </svg>
                        <span><%= home.rating.toFixed(1) %></span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="text-right">
                        <span class="block text-xl font-extrabold text-gray-900">Rs <%= home.price %></span>
                        <span class="text-xs text-gray-500">/ night</span>
                    </div>
                    <% if (isLoggedIn && user && user.userType === 'guest') { %>
                        <div class="shrink-0">
                            <%- include('../partials/favourite', {home : home}) %>
                        </div>
                    <% } %>
                </div>
            </div>

            <% if (home.description) { %>
                <div>
                    <h3 class="text-base font-bold text-gray-900 mb-2">Description</h3>
                    <p class="text-sm text-gray-600 leading-relaxed"><%= home.description %></p>
                </div>
            <% } %>
        </div>
    </main>

</body>
</html>